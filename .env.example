# SUPABASE (Required for production, dev fallback active if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# APP URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# RESEND (Optional: if omitted, notification reminders fallback to in-app notification center)
RESEND_API_KEY=

# CRON SECRET (Protects the notification reminders worker endpoint)
CRON_SECRET=dev-cron-secret-change-me-in-production
